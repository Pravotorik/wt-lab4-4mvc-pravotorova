@model List<wt_lab4_4mvc_pravotorova.Models.Guest>
@{
    ViewData["Title"] = "Гости";
}

<div class="page-container">
    <div class="page-head">
        <div>
            <h1>Наши гости</h1>
            <p>@Model.Count человек выбрали Отель Pravotorik</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="big">✧</div>
            <p>Пока никто не зарегистрировался</p>
        </div>
    }
    else
    {
        <div class="guest-grid">
            @foreach (var g in Model)
            {
                <div class="guest-card">
                    <img src="@g.AvatarUrl" alt="@g.FullName" class="guest-avatar" />
                    <h3 class="guest-name">@g.FullName</h3>
                    <p class="guest-info">@g.Email</p>
                    <p class="guest-info">@g.Phone</p>
                    <p class="guest-info">@g.Country</p>
                </div>
            }
        </div>
    }
</div>